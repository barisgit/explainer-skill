{
	"compilerOptions": {
		"target": "ESNext", "module": "ESNext", "moduleResolution": "bundler",
		"allowImportingTsExtensions": true, "noEmit": true, "strict": true,
		"noUncheckedIndexedAccess": true, "noImplicitOverride": true, "skipLibCheck": true,
		"types": ["bun"]
	},
	"include": ["cli.ts", "src", "build"]
}
