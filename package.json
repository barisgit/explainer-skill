{
	"name": "explainer-skill",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"typecheck": "bun check --no-pretty --all && bun check -p tsconfig.kit.json --no-pretty --all && bun check -p tsconfig.records.json --no-pretty --all",
		"lint": "biome check --error-on-warnings .",
		"format": "biome check --write --error-on-warnings .",
		"test": "bun test",
		"ci": "bun run typecheck && bun run lint && bun run test",
		"vendor": "bun build/vendor.ts",
		"media": "bun build/media.ts",
		"verify:install": "bun build/verify-install.ts",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,js,css,json,jsonc}": "biome check --write --error-on-warnings --no-errors-on-unmatched"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@tanstack/table-core": "9.3.1",
		"@types/bun": "1.4.3",
		"beautiful-mermaid": "1.1.3",
		"echarts": "6.1.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"typescript": "7.0.2"
	},
	"patchedDependencies": {
		"beautiful-mermaid@1.1.3": "patches/beautiful-mermaid@1.1.3.patch"
	}
}
