+/**
+ * Where each node and subgraph is first written: a node's index in graph.nodes (insertion order), a subgraph's that of its
+ * earliest member, less a half so it sorts before that member's siblings.
+ */
+function appearanceRank(graph: MermaidGraph): (id: string) => number {
+  const order = new Map([...graph.nodes.keys()].map((id, i) => [id, i]))
+  const subgraphs = new Map<string, MermaidSubgraph>()
+  const walk = (list: MermaidSubgraph[]) => { for (const sg of list) { subgraphs.set(sg.id, sg); walk(sg.children) } }
+  walk(graph.subgraphs)
+  const rank = (id: string): number => {
+    const sg = subgraphs.get(id)
+    if (!sg) return order.get(id) ?? Number.MAX_SAFE_INTEGER
+    return Math.min(Number.MAX_SAFE_INTEGER, ...sg.nodeIds.map(rank), ...sg.children.map(c => rank(c.id))) - 0.5
+  }
+  return rank
