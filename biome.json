{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"**",
			"!**/*.html",
			"!**/*.md",
			"!skills/explainer/kit/echarts.js",
			"!skills/explainer/vendor/beautiful-mermaid.js",
			"!skills/explainer/vendor/mdx.js",
			"!skills/explainer/vendor/math.js",
			"!skills/explainer/kit/parts/math/temml.css",
			"!skills/explainer/vendor/preact",
			"!skills/explainer/vendor/types",
			"!skills/explainer/vendor/table-core.js",
			"!examples/*/data.json"
		]
	},
	"formatter": { "enabled": true, "indentStyle": "tab", "lineWidth": 100 },
	"linter": {
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": { "maxAllowedComplexity": 15 }
				},
				"noExcessiveLinesPerFunction": {
					"level": "error",
					"options": { "maxLines": 80, "skipBlankLines": true }
				}
			},
			"style": {
				"noExcessiveLinesPerFile": {
					"level": "error",
					"options": { "maxLines": 600 }
				},
				"noNonNullAssertion": "error",
				"useBlockStatements": "error",
				"useImportType": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noTsIgnore": "error",
				"noEvolvingTypes": "error",
				"noImportCycles": "error",
				"noFocusedTests": "error"
			},
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error"
			}
		}
	},
	"javascript": { "formatter": { "quoteStyle": "double" } }
}
